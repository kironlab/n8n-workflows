    {
      "id": "code-prepare-buttons",
      "name": "Prepare Telegram Buttons",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        280
      ],
      "notes": "Truncates content_hash to 16 chars for callback_data — Telegram's callback_data limit is 64 bytes, and 'barmon_approve:' + a full 64-char SHA-256 would overflow it. Matches the production Rob-LinkedIn convention (content_hash.slice(0,16)).",
      "parameters": {
        "jsCode": "const row = $json;\nconst shortHash = row.content_hash.slice(0, 16);\nreturn [{ json: { ...row, short_hash: shortHash } }];"
      }
    },
    {
      "id": "telegram-send-review",
      "name": "Send Draft for Review",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1080,
        280
      ],
      "parameters": {
        "chatId": "={{ $('BarMon Facebook Config').first().json.telegram_chat_id }}",
        "text": "=📝 *{{ $json.profile }} / {{ $json.channel }}* — {{ $json.day_topic }}\n\n{{ $json.draft_content }}\n\n_Fuente: {{ $json.sources_consulted }} — {{ $json.article_url }}_",
        "additionalFields": {
          "parse_mode": "Markdown"
        },
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "✅ Aprobar",
                    "additionalFields": {
                      "callback_data": "=barmon_approve|{{ $json.short_hash }}"
                    }
                  },
                  {
                    "text": "❌ Descartar",
                    "additionalFields": {
                      "callback_data": "=barmon_discard|{{ $json.short_hash }}"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
